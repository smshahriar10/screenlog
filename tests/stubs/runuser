#!/usr/bin/env bash
# stub: runuser -u USER -- CMD ARGS...  (runs CMD as the current user; refuses -l)
set -euo pipefail
{ printf '%q ' "$0" "$@"; printf '\n'; } >>"${STUB_LOG_DIR:?}/runuser.log"
while (($#)); do
  case $1 in
    -l|--login) echo "stub runuser: -l is not allowed" >&2; exit 1 ;;
    -u|--user) shift 2 ;;
    --) shift; break ;;
    *) shift ;;
  esac
done
exec "$@"
