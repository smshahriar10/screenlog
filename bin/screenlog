#!/usr/bin/env bash
# screenlog - the operator CLI (spec section 7).
# Phase 4 scope: report, version, help. The other commands arrive in phase 5.
set -uo pipefail
export LC_ALL=C.UTF-8
umask 077
SCREENLOG_HOME=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd) || exit 1
readonly SCREENLOG_HOME
# shellcheck source=lib/log.sh
. "$SCREENLOG_HOME/lib/log.sh"
# shellcheck source=lib/config.sh
. "$SCREENLOG_HOME/lib/config.sh"
# shellcheck source=lib/time.sh
. "$SCREENLOG_HOME/lib/time.sh"
# shellcheck source=lib/gap.sh
. "$SCREENLOG_HOME/lib/gap.sh"
# shellcheck source=lib/slug.sh
. "$SCREENLOG_HOME/lib/slug.sh"
# shellcheck source=lib/session.sh
. "$SCREENLOG_HOME/lib/session.sh"
# shellcheck source=lib/capture.sh
. "$SCREENLOG_HOME/lib/capture.sh"
# shellcheck source=lib/sample.sh
. "$SCREENLOG_HOME/lib/sample.sh"
# shellcheck source=lib/drive.sh
. "$SCREENLOG_HOME/lib/drive.sh"
# shellcheck source=lib/upload.sh
. "$SCREENLOG_HOME/lib/upload.sh"
# shellcheck source=lib/retention.sh
. "$SCREENLOG_HOME/lib/retention.sh"
# shellcheck source=lib/discord.sh
. "$SCREENLOG_HOME/lib/discord.sh"
# shellcheck source=lib/sheet.sh
. "$SCREENLOG_HOME/lib/sheet.sh"
# shellcheck source=lib/report.sh
. "$SCREENLOG_HOME/lib/report.sh"

SCREENLOG_VERSION=$(<"$SCREENLOG_HOME/VERSION")

cli_help() {
  cat <<HELP
screenlog $SCREENLOG_VERSION - screenshot sampler for Ubuntu 24.04 desktops

Usage: screenlog <command> [options]

Commands (all but version and help need root: sudo screenlog <command>)
  report [--date YYYY-MM-DD] [--pending] [--dry-run]
                 Build and post daily reports. --pending (the default) posts every due day that
                 is not reported yet; --date posts one day; --dry-run writes the message JSON and
                 the contact sheet to a temp dir, prints the paths and makes no network calls.
  version        Print the version.
  help           This text.

Exit codes: 0 ok, 1 runtime failure, 2 usage, 3 config invalid, 4 root required,
            5 another run holds the lock, 6 missing dependency, 7 remote check failed,
            8 system file edit failed, 130 interrupted.
HELP
}

cli_on_signal() {
  stop_children
  die "$EXIT_INTERRUPTED" "interrupted"
}

usage_error() {
  log_error "$*"
  printf 'Run: screenlog help\n' >&2
  exit "$EXIT_USAGE"
}

cli_report() {
  local day="" pending=0 dry=""
  while (($#)); do
    case $1 in
      --date) [[ -n ${2:-} ]] || usage_error "--date needs YYYY-MM-DD"; day=$2; shift 2 ;;
      --date=*) day=${1#--date=}; shift ;;
      --pending) pending=1; shift ;;
      --dry-run) dry=dry; shift ;;
      *) usage_error "report: unknown option $1" ;;
    esac
  done
  if [[ -n $day ]]; then
    (( pending )) && usage_error "report: --date and --pending exclude each other"
    [[ $day =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || usage_error "report: --date needs YYYY-MM-DD"
    [[ -d $SHOTS_DIR/$day ]] || usage_error "report: no local folder for $day"
    if [[ $dry != dry ]] && state_day_reported "$day"; then
      printf 'already reported on %s; use --dry-run to rebuild\n' "$day"
      return 0
    fi
    [[ $dry == dry ]] || report_lock
    DISCORD_DEADLINE=$(( EPOCHSECONDS + ${SCREENLOG_REPORT_DEADLINE:-1500} ))
    report_day "$day" "$dry"
    return
  fi
  [[ $dry == dry ]] || report_lock
  report_pending "$dry"
}

main() {
  local cmd=${1:-help}
  shift || true
  case $cmd in
    version) printf '%s\n' "$SCREENLOG_VERSION"; exit 0 ;;
    help|-h|--help) cli_help; exit 0 ;;
    report) ;;
    *) usage_error "unknown command: $cmd" ;;
  esac
  require_root "$cmd"
  config_load
  tmp_init
  SCREENLOG_LOCK_WAIT=${SCREENLOG_LOCK_WAIT:-900}
  trap cli_on_signal INT TERM
  case $cmd in
    report) cli_report "$@" ;;
  esac
}

main "$@"
