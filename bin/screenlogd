#!/usr/bin/env bash
# screenlogd - screenlog sampler daemon (spec section 5.1).
#   screenlogd            the service: first-run announcement, then the sampling loop forever
#   screenlogd --once     one sample now (best-effort upload), exit 0
#   screenlogd --announce the first-run announcement only
set -uo pipefail
export LC_ALL=C.UTF-8
umask 077
SCREENLOG_HOME=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd) || exit 1
readonly SCREENLOG_HOME
# shellcheck source=lib/log.sh
. "$SCREENLOG_HOME/lib/log.sh"
# shellcheck source=lib/config.sh
. "$SCREENLOG_HOME/lib/config.sh"
# shellcheck source=lib/time.sh
. "$SCREENLOG_HOME/lib/time.sh"
# shellcheck source=lib/gap.sh
. "$SCREENLOG_HOME/lib/gap.sh"
# shellcheck source=lib/session.sh
. "$SCREENLOG_HOME/lib/session.sh"
# shellcheck source=lib/capture.sh
. "$SCREENLOG_HOME/lib/capture.sh"
# shellcheck source=lib/sample.sh
. "$SCREENLOG_HOME/lib/sample.sh"
# shellcheck source=lib/drive.sh
. "$SCREENLOG_HOME/lib/drive.sh"
# shellcheck source=lib/upload.sh
. "$SCREENLOG_HOME/lib/upload.sh"
# shellcheck source=lib/retention.sh
. "$SCREENLOG_HOME/lib/retention.sh"
# shellcheck source=lib/discord.sh
. "$SCREENLOG_HOME/lib/discord.sh"

SCREENLOG_VERSION=$(<"$SCREENLOG_HOME/VERSION")

# daemon_sample: one sample inside the capture window, recorded, uploaded (best effort, one
# rclone attempt, at most 5 s waiting for the lock) and logged on one line. Never fails.
daemon_sample() {
  local up=skipped rc=0
  sample_take
  sample_record || log_error "cannot write $(csv_path "$SAMPLE_DAY")"
  if [[ $SAMPLE_STATUS == shot ]]; then
    if upload_day "$SAMPLE_DAY" quick; then
      up=ok
    else
      rc=$?
      up="failed($rc)"
      if (( rc == 75 )); then up="skipped(lock busy)"; fi
    fi
  fi
  log_info "$(sample_log_line) upload=$up${UPLOAD_ERROR:+ upload_error=\"$(log_redact_str "$UPLOAD_ERROR")\"}"
}

daemon_once() {
  if ! time_in_window "$CAPTURE_START" "$CAPTURE_END"; then
    log_info "outside capture hours ($CAPTURE_START-$CAPTURE_END); nothing to do"
    return 0
  fi
  daemon_sample
}

# daemon_announce BOUND_SECONDS: the first-run announcement (spec 5.1.2). Polls for a capturable
# session every SCREENLOG_ANNOUNCE_INTERVAL seconds, takes one shot (reused for up to 10 minutes
# of retries), uploads it and posts the message once; the flag is created only after a 2xx.
# Returns 0 when posted, 1 when the bound ran out, the webhook is rejected or a stop came.
daemon_announce() {
  local bound=${1:-900} shot_epoch=0 img="$SCREENLOG_TMP/announce.jpg" interval deadline posted=0
  interval=$(awk -v i="${SCREENLOG_ANNOUNCE_INTERVAL:-30}" 'BEGIN { if (i + 0 < 0.2) i = 0.2; print i + 0 }')
  deadline=$(( EPOCHSECONDS + bound ))
  while (( RUN_STOP == 0 )); do
    if (( EPOCHSECONDS - shot_epoch > 600 )); then
      sample_take
      if [[ $SAMPLE_STATUS == shot ]]; then
        if time_in_window "$CAPTURE_START" "$CAPTURE_END"; then
          sample_record || log_error "cannot write $(csv_path "$SAMPLE_DAY")"
        fi
        upload_day "$SAMPLE_DAY" quick || log_warn "announce: upload failed ($(log_redact_str "$UPLOAD_ERROR"))"
        if discord_prepare_image "$SHOTS_DIR/$SAMPLE_DAY/$SAMPLE_FILE" "$img"; then
          shot_epoch=$EPOCHSECONDS
        else
          log_warn "announce: cannot prepare the image"
        fi
      else
        log_info "announce: waiting for a capturable session (status=$SAMPLE_STATUS${SAMPLE_DETAIL:+: $SAMPLE_DETAIL})"
      fi
    fi
    if (( shot_epoch > 0 )); then
      if SCREENLOG_DISCORD_BACKOFF="" discord_post "✅ Screenlog is running on ${EMPLOYEE_NAME}'s PC ($(hostname), v$SCREENLOG_VERSION)" "$img"; then
        touch "$STATE_DIR/setup-announced"
        log_info "announce: posted (HTTP $DISCORD_LAST_HTTP)"
        posted=1
        break
      fi
      case $DISCORD_LAST_KIND in
        http|dead)
          log_error "announce: webhook rejected ($DISCORD_LAST_ERROR); fix DISCORD_WEBHOOK_URL, then: screenlog apply-config"
          return 1 ;;
        *) log_warn "announce: post failed ($DISCORD_LAST_ERROR)" ;;
      esac
    fi
    if (( EPOCHSECONDS >= deadline )); then
      log_warn "announce: not posted yet; sampling starts, the announcement is retried hourly"
      return 1
    fi
    sleep_interruptible "$interval" || return 1
  done
  (( posted ))
}

# daemon_loop: forever - random gap, skip silently outside the window, else one sample. While the
# first-run flag is absent, the announcement is retried at most hourly from here.
daemon_loop() {
  local gap next_announce=0
  while (( RUN_STOP == 0 )); do
    gap=$(gap_next)
    sleep_interruptible "$gap" || break
    if [[ ! -f $STATE_DIR/setup-announced && -z ${SCREENLOG_SKIP_ANNOUNCE:-} ]] && (( EPOCHSECONDS >= next_announce )); then
      next_announce=$(( EPOCHSECONDS + 3600 ))
      daemon_announce 0 || true
      (( RUN_STOP == 0 )) || break
    fi
    time_in_window "$CAPTURE_START" "$CAPTURE_END" || continue
    daemon_sample
  done
  log_info "screenlogd stopping"
}

main() {
  local mode=${1:-loop}
  case $mode in
    loop|--once|--announce) ;;
    *) die "$EXIT_USAGE" "usage: screenlogd [--once|--announce]" ;;
  esac
  config_load
  tmp_init
  mkdir -p -- "$STATE_DIR" "$WORK_TMP_DIR" || die "$EXIT_RUNTIME" "cannot create $STATE_DIR"
  SCREENLOG_LOCK_WAIT=${SCREENLOG_LOCK_WAIT:-5}   # a quick upload must not stall sampling
  trap stop_children TERM INT
  case $mode in
    --once) daemon_once; exit 0 ;;
    --announce) daemon_announce "${SCREENLOG_ANNOUNCE_BOUND:-900}"; exit ;;
  esac
  log_info "screenlogd v$SCREENLOG_VERSION starting (window $CAPTURE_START-$CAPTURE_END, ~$SHOTS_PER_HOUR shots/h)"
  if [[ ! -f $STATE_DIR/setup-announced && -z ${SCREENLOG_SKIP_ANNOUNCE:-} ]]; then
    daemon_announce "${SCREENLOG_ANNOUNCE_BOUND:-900}" || true
  fi
  daemon_loop
  exit 0
}

main "$@"
